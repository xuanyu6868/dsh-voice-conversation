{
  "name": "@local/voice-conversation",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Hands-free voice conversation: auto-send after voice transcription and read assistant replies aloud.",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.mjs",
    "impl.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
