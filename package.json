{
  "name": "@local/voice-conversation",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Hands-free voice conversation: auto-send after voice transcription and read assistant replies aloud.",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.mjs",
    "impl.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "HANDOFF.md",
    "docs/*.md",
    "docs/voice-preview.html",
    "edge-bridge/*.py",
    "edge-bridge/requirements.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check client.js && node --check impl.mjs && node --check host.mjs"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-test-renderer": "18.2.0"
  }
}
